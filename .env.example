# =============================================================================
# DOS CLUB TALENTOS — VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Set these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Production / Preview / Development
# =============================================================================

# 1. Supabase Database & Auth (Mandatory)
# Remote Supabase Project Endpoint URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Remote Supabase Anonymous Public API Key (Client-side safe, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Remote Supabase Service Role Secret Key (Server-only, bypasses RLS for administrative routines)
# WARNING: NEVER expose this key in client-side bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Security & QR Check-in Signing (Mandatory)
# High-entropy 32+ character random secret used for HMAC SHA-256 geofenced QR codes
QR_SIGNING_SECRET=generate_a_random_32_or_64_character_signing_secret_here

# 3. Canonical Application Base URL (Mandatory)
# On Vercel, set this to your custom domain or Vercel production deployment URL
NEXT_PUBLIC_APP_URL=https://talentos.descienceosclub.com

# 4. Firebase Cloud Messaging / Web Push Notifications (Optional for PWA alerts)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=103948572019
NEXT_PUBLIC_FIREBASE_APP_ID=1:103948572019:web:abcdef123456
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BOs...
FIREBASE_SERVER_KEY=AAAA...
