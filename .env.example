# =============================================================================
# DOS CLUB TALENTOS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Duplicate this file to .env.local and populate the corresponding credentials.
# Do NOT commit .env.local to version control.

# Remote Supabase Project Endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Remote Supabase Anonymous Public API Key (Client-side safe, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Remote Supabase Service Role Secret Key (Server-only, bypasses RLS for administrative routines)
# WARNING: NEVER expose this key in client-side bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Canonical Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
